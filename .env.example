# Copy to .env (git-ignored). Never commit values. New keys go here with an empty value.

# NASA Earthdata Login (ASF DAAC / NISAR)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=

# Google Earth Engine + Cloud Storage
GCP_PROJECT_ID=
GEE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=
GCS_BUCKET=

# LLM providers for the orchestrator chain (config/bailasar.yaml llm:); set any you have
NEBIUS_API_KEY=
FEATHERLESS_API_KEY=
OPENROUTER_API_KEY=

# LangSmith tracing of the LangGraph agents (agents/tracing.py); leave the key empty to run untraced
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=

# Vertex AI Gemini (orchestrator LLM via ADC; enable aiplatform.googleapis.com). Uses GCP_PROJECT_ID.
VERTEX_LOCATION=us-central1

# Runtime
MCP_TRANSPORT=sse
OFFLINE_DEMO_MODE=0

# --- GraphRAG (landslide conceptual grounding) · Azure OpenAI ---
# Create an Azure OpenAI resource + deploy a chat model and an embedding model.
GRAPHRAG_API_KEY=
GRAPHRAG_API_BASE=
GRAPHRAG_API_VERSION=2024-10-21
GRAPHRAG_CHAT_DEPLOYMENT=
GRAPHRAG_CHAT_MODEL=gpt-4o-mini
GRAPHRAG_EMBEDDING_DEPLOYMENT=
GRAPHRAG_EMBEDDING_MODEL=text-embedding-3-small
