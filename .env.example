# Copy to .env (git-ignored). Never commit values. New keys go here with an empty value.

# NASA Earthdata Login (ASF DAAC / NISAR)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=

# Google Earth Engine + Cloud Storage
GCP_PROJECT_ID=
GEE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=
GCS_BUCKET=

# LLM provider for the synthesis agent
ANTHROPIC_API_KEY=

# Runtime
MCP_TRANSPORT=sse
OFFLINE_DEMO_MODE=0
