{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BailaSAR cache release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "build_time_utc", "source_commit", "archive", "parts", "provenance"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "build_time_utc": {
      "type": "string", "format": "date-time", "pattern": "(Z|\\+00:00)$"
    },
    "source_commit": {"type": "string", "pattern": "^([a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"},
    "archive": {"$ref": "#/$defs/asset"},
    "parts": {
      "type": "array", "minItems": 1,
      "description": "Parts are ordered; index equals array position, contiguous from zero. Names must be unique and must not equal the archive name or cache_manifest.json.",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "sha256", "size_bytes", "index"],
        "properties": {
          "name": {"$ref": "#/$defs/assetName"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "size_bytes": {"type": "integer", "minimum": 1, "maximum": 2147483647},
          "index": {"type": "integer", "minimum": 0}
        }
      }
    },
    "provenance": {
      "type": "array",
      "description": "Exactly one entry per archived regular file; paths must be unique.",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "source", "granule_ids", "missing"],
        "properties": {
          "path": {
            "type": "string", "minLength": 1,
            "pattern": "^(?!/)(?!.*[\\\\:\\u0000-\\u001f])(?!.*[. ](?:/|$))[^/]+(?:/[^/]+)*$"
          },
          "sha256": {"$ref": "#/$defs/sha256"},
          "source": {"enum": ["live", "cached"]},
          "granule_ids": {"type": "array", "items": {"type": "string", "pattern": "\\S"}},
          "missing": {"type": "boolean"}
        },
        "allOf": [{
          "if": {"properties": {"missing": {"const": false}}},
          "then": {"properties": {"granule_ids": {"minItems": 1}}}
        }]
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "assetName": {
      "type": "string", "pattern": "^(?!.*\\.$)(?!.*[\\u0000-\\u001f])[a-zA-Z0-9._-]+$"
    },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "sha256", "size_bytes"],
      "properties": {
        "name": {"$ref": "#/$defs/assetName"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
